{
  "name": "drgribbe",
  "version": "1.42.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-messages.mjs",
    "prebuild": "node scripts/generate-messages.mjs && node scripts/generate-last-modified.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "pnpm exec tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/third-parties": "16.4.6",
    "@vercel/analytics": "^2.0.1",
    "classnames": "2.5.1",
    "lucide-react": "1.74.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/postcss": "4.3.5",
    "@types/js-cookie": "3.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "postcss": "8.5.33",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{css,scss,less,json,jsonc,json5,md,mdx,yml,yaml,toml,html}": "oxfmt --no-error-on-unmatched-pattern"
  }
}
